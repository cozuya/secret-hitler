# Default to LF everywhere (consistent across macOS/Windows).
* text=auto eol=lf

# Explicit text files.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.pug text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Windows-only scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binaries as binary.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.zip -text
*.gz -text
*.tgz -text
*.woff -text
*.woff2 -text
*.eot -text
*.ttf -text
*.otf -text
*.mp3 -text
*.wav -text
